/ios
/android

# daily brief recordings (made again from the brief any time)
docs/briefs/audio/

# Coming soon site build (has the public key filled in; rebuild with npm run build:coming-soon)
coming-soon/out/

# Launch builds made ahead of time (rebuild with npm run build:web:launch)
launch/

# Founders website (link only for founding businesses before launch; rebuild with npm run build:web:founders)
founders/
