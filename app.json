{
  "expo": {
    "name": "Servly AG",
    "slug": "servly-ag",
    "scheme": "servlyag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.servlyag.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.servlyag.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#0072C6"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Servly AG needs your photos so you can show your work."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0072C6"
        }
      ],
      "expo-asset",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "73c20633-e5a5-4de2-a9db-673a16c3a060"
      }
    },
    "owner": "servlyag"
  }
}
