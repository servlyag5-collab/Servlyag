    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.1.0",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.19",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.33",
    "expo-sharing": "~58.0.24",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.16",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:db": "node scripts/check-database.js",
    "build:web": "expo export --platform web --output-dir dist --clear && node scripts/fix-web-assets.js",
    "build:coming-soon": "node scripts/build-coming-soon.js",
    "build:web:launch": "node scripts/build-web-launch.js",
    "build:web:founders": "node scripts/build-web-founders.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ]
  }
